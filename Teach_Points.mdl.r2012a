    decomposition	    CLUSTER_CHART
    type		    EML_CHART
    firstData		    4
    chartFileNumber	    2
    disableImplicitCasting  1
    eml {
      name		      "getToolOffset"
    }
  }
  state {
    id			    3
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    2
    treeNode		    [2 0 0 0]
    superState		    SUBCHART
    subviewer		    2
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function tool_offset = getToolOffset(Encoders)\n\n%convert encoder values to angles using bias an"
      "d gain\nbias = [-2048 -2654 -2048];\ngain = [2*pi()/4915 2*pi()/4096 2*pi()/4915];\nAngle = (Encoders' + bias).*"
      "gain;\n\n% convert the angle to the positive rotation convention defined\n% by DH parameters\npos_rot = [-1 1 1]"
      ";\njoint_offset = [0 -(40-180)*pi/180 0];\nJoint456 = Angle.*pos_rot + joint_offset;\n\n%pick off theta4 and the"
      "ta5\ntheta4 = Joint456(1);\ntheta5 = Joint456(2);\n\n% The orientation of the tool offset matrix is given two su"
      "ccessive\n% rotations about x and z axis. \nRotZ = [cos(theta5) -sin(theta5) 0; sin(theta5) cos(theta5) 0; 0 0 1"
      "];\nRotX = [1 0 0; 0 cos(theta4) -sin(theta4); 0 sin(theta4) cos(theta4)];\nR = RotX*RotZ; % R is the rotation m"
      "atrix of the tool offset matrix with respect to frame 3\n\n% with respect to frame 3, the tool is 0.039m in the "
      "x-direction. Convert\n% this vector to tool frame coordinates\ntool_pos =R * [.039; 0; 0];\n\n%create a Tool_off"
      "set transformation matrix. Use Identity matrix for\n%rotation to show that the end effector frame and frame 3 ar"
      "e always\n%aligned\nI = [1 0 0; 0 1 0; 0 0 1];\ntool = cat(2,I,tool_pos);\ntool_offset = cat(1,tool,[0 0 0 1]);\n"
      "\n"
      editorLayout	      "100 M4x1[2148 111 1200 693]"
    }
  }
  data {
    id			    4
    ssIdNumber		    4
    name		    "Encoders"
    linkNode		    [2 0 5]
    scope		    INPUT_DATA
    machine		    1
    props {
      array {
	size			"-1"
      }
      type {
	method			SF_INHERITED_TYPE
	primitive		SF_DOUBLE_TYPE
      }
      complexity	      SF_COMPLEX_INHERITED
    }
    dataType		    "Inherit: Same as Simulink"
  }
