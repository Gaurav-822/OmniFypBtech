  chart {
    id			    44
    name		    "Inverse Kinematics"
    windowPosition	    [933 368.75 213 385]
    viewLimits		    [0 156.75 0 153.75]
    screen		    [1 1 1920 1080 1.333333333333333]
    treeNode		    [0 45 0 0]
    firstTransition	    53
    firstJunction	    52
    viewObj		    44
    machine		    1
    ssIdHighWaterMark	    9
    decomposition	    CLUSTER_CHART
    type		    EML_CHART
    firstData		    46
    chartFileNumber	    10
    disableImplicitCasting  1
    eml {
      name		      "InverseKinematics"
    }
    supportVariableSizing   0
  }
  state {
    id			    45
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    44
    treeNode		    [44 0 0 0]
    superState		    SUBCHART
    subviewer		    44
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [q1,q2,q3] = InverseKinematics(pos,rot,tool_offset)\n%DESCRIPTION-----------------------"
      "----------------------------------------\n%Compute inverse kinematics using first three joints of OMNI and a too"
      "l\n%offset.\n\n%INPUTS--------------------------------------------------------------------\n%pos - x,y,z positio"
      "n of the tool with respect to the base frame\n%rot - Rotation of the tool with respect to the base frame\n%tool_"
      "offset - x,y,z position and rotation of the tool with respect to frame 3\n\n%OUTPUTS----------------------------"
      "---------------------------------------\n%q - position of q1, q2, q3\n\n%EXTERNAL REFERENCE---------------------"
      "-----------------------------------\n%Refer to InverseKinematics_from_Geometry.ppt for a diagram of how the inve"
      "rse kinematics are computed\n\n%Link Lengths\nL1 = .132;\nL2 = .132;\n\n%Rotate tool_offset from frame 3 to fram"
      "e 0 coordinates\ntool = rot*tool_offset(1:3,4);\n\n% Subtract tool_offset (in frame 0 coord) from the position o"
      "f the end-effector (in frame 0 coord) \n% to get position of the origin of frame 3.\nx = pos(1)-tool(1);\ny = po"
      "s(2)-tool(2);\nz = pos(3)-tool(3);\n\n\n% distance to frame 3 in x,y plane of base frame\nd = sqrt(x^2 + y^2);\n"
      "\n%distance to frame 3 in base frame\nk = sqrt(d^2+z^2);\n\n% q1 is a function of x and y only\nq1 = atan(y/x);\n"
      "\n% Using the cosine law: cos(3*pi/2 - q3) = (L1^2+L2^2-k^2)/(2*L1*L2)\nq3 = 3*pi/2 - acos((L1^2+L2^2-k^2)/(2*L1"
      "*L2));\n\n% phi is positive for z < 0, negative for z > 0, 0 for z = 0.\nif (z < 0)\n    phi = acos(d/k); \nelse"
      "\n    phi = - acos(d/k);\nend\n\n%using the sin law: sin(gamma)/L2 = sin(3*pi/2-q3)/k\ngamma = asin((L2*sin(3*pi"
      "/2-q3))/k);\nq2 = phi-gamma;\n\n\n"
      editorLayout	      "100 M4x1[499 34 931 925]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', true)"
      fimathForFiConstructors FimathMatlabFactoryDefault
      emlDefaultFimath	      FimathUserSpecified
    }
  }
