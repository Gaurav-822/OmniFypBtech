  state {
    id			    19
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    18
    treeNode		    [18 0 0 0]
    superState		    SUBCHART
    subviewer		    18
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function inter = linear_interpolator( final, current, speed, sample_time)\n\nstep = speed*sample_"
      "time;\ninter = current + sign(final-current).*step;\n\n\nfor i = 1:length(final)\n    if ( abs (final(i)-current"
      "(i)) < step(i))\n        inter(i) = final(i);\n    end\nend\nend"
      editorLayout	      "100 M4x1[146 214 671 364]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', true)"
      fimathForFiConstructors FimathMatlabFactoryDefault
      emlDefaultFimath	      FimathUserSpecified
