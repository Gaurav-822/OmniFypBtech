      script		      "function cost = compute_cost_block(err)\n% err is a 1x3 or 3x1 vector: [ex ey ez]\n\n% Unpack\nex"
      " = err(1);\ney = err(2);\nez = err(3);\n\n% Compute instantaneous cost (squared error)\ncost = ex^2 + ey^2 + ez^"
      "2;\nend\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
