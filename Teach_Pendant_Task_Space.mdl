  state {
    id			    53
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    52
    treeNode		    [52 0 0 0]
    superState		    SUBCHART
    subviewer		    52
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function total_cost = cost_sum_segmentwise(cost_input, ...\n                                     "
      "      current_iteration, segment_lengths)\n%#codegen\n% Segment-wise cost accumulator aligned with PID & PSO seg"
      "ment logic\n\nMAX_SEG = 10;\n\npersistent cost_accum last_seg initialized\n\nif isempty(initialized)\n    cost_a"
      "ccum = zeros(1,MAX_SEG);\n    last_seg = -1;\n    initialized = true;\nend\n\n% ===== SEGMENT DETECTION (same as"
      " PID & PSO) =====\ntotal_length = sum(segment_lengths);\neff_iteration = mod(current_iteration-1,total_length)+1"
      ";\nbound = cumsum(segment_lengths);\n\ncurrent_seg = 1;\nfor i=1:length(bound)\n    if eff_iteration <= bound(i)"
      "\n        current_seg = i;\n        break\n    end\nend\n\n% ===== SEGMENT RESET =====\nif current_seg ~= last_s"
      "eg\n    cost_accum(current_seg) = 0;\nend\n\nlast_seg = current_seg;\n\n% ===== ACCUMULATE =====\ncost_accum(cur"
      "rent_seg) = cost_accum(current_seg) + cost_input;\n\ntotal_cost = cost_accum(current_seg);\n\nend"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
