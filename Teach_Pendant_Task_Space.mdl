  state {
    id			    36
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    35
    treeNode		    [35 0 0 0]
    superState		    SUBCHART
    subviewer		    35
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [Kp,Ki,Kd,best_Kp,best_Ki,best_Kd,current_seg] = ...\n    pid_auto_tuner(current_point,s"
      "tarting_point,cost,...\n                   current_iteration,segment_lengths)\n%#codegen\n\ncoder.extrinsic('sto"
      "re_pid_segment')\n\nNUM_PARTICLES = 20;\nDIM = 6;\nMAX_SEG = 10;\ntol = 0.05;\n\nw  = 0.7;\nc1 = 1.5;\nc2 = 3.0;"
      "\n\npersistent particles velocities pbest pbest_cost ...\n           gbest gbest_cost current_particle ...\n    "
      "       eval_count in_zone_prev initialized\n\nif isempty(initialized)\n\n    particles = rand(NUM_PARTICLES,DIM,"
      "MAX_SEG);\n    velocities = zeros(NUM_PARTICLES,DIM,MAX_SEG);\n    pbest = particles;\n    pbest_cost = inf(NUM_"
      "PARTICLES,MAX_SEG);\n\n    gbest = zeros(MAX_SEG,DIM);\n    gbest_cost = inf(1,MAX_SEG);\n\n    current_particle"
      " = ones(1,MAX_SEG);\n    eval_count = zeros(1,MAX_SEG);\n    in_zone_prev = false(1,MAX_SEG);\n\n    initialized"
      " = true;\nend\n\n% ===== SEGMENT DETECTION =====\ntotal_length = sum(segment_lengths);\neff_iteration = mod(curr"
      "ent_iteration-1,total_length)+1;\nbound = cumsum(segment_lengths);\n\ncurrent_seg = 1;\nfor i=1:length(bound)\n "
      "   if eff_iteration <= bound(i)\n        current_seg = i;\n        break\n    end\nend\n\n% ===== CURRENT PARTIC"
      "LE PID (last used) =====\ncp = current_particle(current_seg);\nx = squeeze(particles(cp,:,current_seg));\n\n[Kp,"
      "Ki,Kd] = scale_and_unpack(x);\n\n% ===== CURRENT SEGMENT BEST PID =====\ng = squeeze(gbest(current_seg,:));\n[be"
      "st_Kp,best_Ki,best_Kd] = scale_and_unpack(g);\n\n% ===== LAP TRIGGER =====\nin_zone = (norm(current_point-starti"
      "ng_point) < tol);\ntrigger = in_zone && ~in_zone_prev(current_seg);\nin_zone_prev(current_seg) = in_zone;\n\nif "
      "trigger\n\n    % ---- PBEST ----\n    if cost < pbest_cost(cp,current_seg)\n        pbest_cost(cp,current_seg) ="
      " cost;\n        pbest(cp,:,current_seg) = x;\n    end\n\n    % ---- GBEST ----\n    if cost < gbest_cost(current"
      "_seg)\n        gbest_cost(current_seg) = cost;\n        gbest(current_seg,:) = x;\n    end\n\n    % ---- ALWAYS "
      "STORE CURRENT GBEST ----\n    g = squeeze(gbest(current_seg,:));\n    [bKp,bKi,bKd] = scale_and_unpack(g);\n    "
      "best_PID = [bKp bKi bKd];\n    store_pid_segment(best_PID,current_seg);\n\n    % ---- NEXT PARTICLE ----\n    ev"
      "al_count(current_seg) = eval_count(current_seg)+1;\n\n    cp = cp + 1;\n    if cp > NUM_PARTICLES\n        cp = "
      "1;\n    end\n    current_particle(current_seg) = cp;\n\n    % ---- PSO UPDATE ----\n    if eval_count(current_se"
      "g) >= NUM_PARTICLES\n\n        for i=1:NUM_PARTICLES\n            xi = squeeze(particles(i,:,current_seg));\n   "
      "         vi = squeeze(velocities(i,:,current_seg));\n            pi = squeeze(pbest(i,:,current_seg));\n        "
      "    gi = squeeze(gbest(current_seg,:));\n\n            r1 = rand(1,DIM);\n            r2 = rand(1,DIM);\n\n     "
      "       vi = w*vi + c1*r1.*(pi-xi) + c2*r2.*(gi-xi);\n            xi = xi + vi;\n            xi = max(0,min(1,xi)"
      ");\n\n            particles(i,:,current_seg) = xi;\n            velocities(i,:,current_seg) = vi;\n        end\n"
      "\n        eval_count(current_seg) = 0;\n    end\nend\n\nend\n\n\nfunction [Kp,Ki,Kd] = scale_and_unpack(x)\n\nKp"
      " = [1.79;1.46;0.60];\n\nKi = [\n    scale(x(1),0,2)\n    scale(x(2),0,2)\n    scale(x(3),0,3)\n];\n\nKd = [\n   "
      " scale(x(4),0.02,0.1)\n    scale(x(5),0.02,0.1)\n    scale(x(6),0,0.025)\n];\n\nend\n\nfunction y = scale(v,a,b)"
      "\ny = a + v*(b-a);\nend"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
